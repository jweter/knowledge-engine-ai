{
  "schema_version": 4,
  "portfolio_project": "Knowledge Engine",
  "repository": "jweter/knowledge-engine-ai",
  "repository_role": "ai",
  "source_of_truth": "GitHub repository state plus authoritative documents listed below",
  "authoritative_documents": [
    "docs/project-status.yaml",
    "docs/agent-development-policy.md",
    "docs/ai_design.md",
    "docs/roadmap/future_ai_orchestration_plan.md",
    "docs/web_integration_design.md",
    "docs/INDUSTRY_REALITY_CHECK.md",
    "AGENTS.md",
    "CLAUDE.md"
  ],
  "definition_of_done": {
    "implementation_complete": true,
    "tests_required_for_change_scope": true,
    "current_required_ci_green": true,
    "mergeability_resolved": true,
    "blocking_reviews_and_comments_resolved": true,
    "architecture_security_licensing_provenance_privacy_clear": true,
    "documentation_updated_when_project_reality_changes": true,
    "regression_protection_for_reproduced_bugs": "when practical",
    "product_reality": "pre-merge only when explicitly documented; otherwise track as post-merge acceptance debt"
  },
  "invariants": [
    "grounded_synthesis_only",
    "confidence_not_fabricated",
    "core_evidence_authority_preserved",
    "ai_web_core_boundary_separation"
  ],
  "verification": {
    "automated_lanes": [
      "quality",
      "security",
      "unit_integration",
      "retrieval_golden_question_benchmark",
      "contract_compatibility"
    ],
    "product_reality_lanes": [
      "monster_79_end_to_end_research_report"
    ],
    "rule": "never convert missing human evidence into PASS; keep implementation status separate from Product Reality acceptance",
    "executable_lanes": [
      {
        "id": "research_report_ai_golden",
        "steps": [
          [
            "poetry",
            "run",
            "pytest",
            "tests/test_research_case_query_plan.py",
            "tests/copilot/test_research_state.py",
            "tests/copilot/test_progress_report.py",
            "-q"
          ]
        ],
        "evidence": "AI research query-plan, state-machine, and progress-report regression"
      }
    ]
  },
  "work_ownership": {
    "authority": "GitHub",
    "active_work_sources": [
      "open pull requests",
      "open issues with active implementation evidence",
      "recent focused branches/commits when attributable"
    ],
    "rule": "do not duplicate or compete with active work; prefer finishing existing work"
  },
  "regression_memory": {
    "path": "engineering/regression-memory.json",
    "rule": "record significant or recurring reproduced failures with root cause, fix, verification, regression protection, and residual risk"
  },
  "readiness_scoring": {
    "mode": "evidence-derived",
    "prohibit_guessed_percent_complete": true,
    "dimensions": [
      "implementation",
      "automated_verification",
      "integration",
      "product_reality",
      "documentation",
      "security_and_policy"
    ],
    "rule": "report unknown when evidence is insufficient"
  },
  "continuation": "derive from AI roadmap, current issues/PRs, and Research Report v1 acceptance",
  "cross_repo_authorities": [
    {
      "repository": "jweter/knowledge-engine-core",
      "path": "docs/roadmap/research_report_v1.md",
      "purpose": "family Research Report v1 authority"
    }
  ],
  "portfolio_aggregation": {
    "project_key": "knowledge-engine",
    "component_role": "ai",
    "required_components": [
      "core",
      "web",
      "ai"
    ],
    "authority": "hourly portfolio orchestrator",
    "rule": "aggregate only verified repository evidence; never infer missing component state"
  },
  "golden_scenarios": [
    {
      "id": "research-report-v1",
      "component": "ai",
      "lane": "research_report_ai_golden",
      "rule": "portfolio scenario is VERIFIED only when core, web, and ai component lanes are green on their current exact heads"
    }
  ],
  "preflight": {
    "required_before_pr": true,
    "evidence_file": "preflight-evidence.json",
    "format_apply": [
      "poetry",
      "run",
      "ruff",
      "format",
      "."
    ],
    "checks": [
      {
        "id": "format",
        "argv": [
          "poetry",
          "run",
          "ruff",
          "format",
          "--check",
          "."
        ],
        "kind": "quality",
        "fast": true
      },
      {
        "id": "lint",
        "argv": [
          "poetry",
          "run",
          "ruff",
          "check",
          "."
        ],
        "kind": "quality",
        "fast": true
      },
      {
        "id": "orchestrator_ops",
        "argv": [
          "python",
          "engineering/orchestrator_ops.py",
          "--help"
        ],
        "kind": "governance",
        "fast": true
      },
      {
        "id": "growth_engine",
        "argv": [
          "python",
          "engineering/growth_engine.py",
          "validate"
        ],
        "kind": "governance",
        "fast": true
      },
      {
        "id": "control_plane",
        "argv": [
          "poetry",
          "run",
          "python",
          "engineering/validate_control_plane.py"
        ],
        "kind": "governance",
        "fast": true
      },
      {
        "id": "regression_memory",
        "argv": [
          "poetry",
          "run",
          "python",
          "engineering/validate_regression_memory.py"
        ],
        "kind": "governance",
        "fast": true
      },
      {
        "id": "types",
        "argv": [
          "poetry",
          "run",
          "mypy",
          "knowledge_engine_ai",
          "tests"
        ],
        "kind": "quality",
        "fast": false
      },
      {
        "id": "tests",
        "argv": [
          "poetry",
          "run",
          "pytest",
          "-q"
        ],
        "kind": "test",
        "fast": false
      },
      {
        "id": "golden",
        "argv": [
          "poetry",
          "run",
          "python",
          "engineering/run_verification.py",
          "--lane",
          "research_report_ai_golden"
        ],
        "kind": "golden",
        "fast": false
      }
    ],
    "policy": "ordinary PRs require GREEN full preflight evidence on the exact head; use PREFLIGHT_UNVERIFIED only for a legitimate environment limitation and record the reason"
  },
  "promotion": {
    "states": [
      "IMPLEMENTING",
      "PREFLIGHT_UNVERIFIED",
      "PREFLIGHT_GREEN",
      "PR_OPEN",
      "CI_PENDING",
      "GREEN",
      "MERGED",
      "PRODUCT_REALITY_PENDING",
      "PRODUCT_REALITY_VERIFIED"
    ],
    "rule": "advance only from verified evidence; never skip FAILED/PENDING/UNCERTAIN gates"
  },
  "orchestration": {
    "promotion_workflow": ".github/workflows/promote-preflight-green.yml",
    "promotion_branch_prefix": "orchestrator/",
    "product_reality_recorder": "engineering/orchestrator_ops.py record-product-reality",
    "product_reality_evidence_dir": "engineering/product-reality-evidence",
    "live_status_file": "engineering/live-status.json",
    "live_status_workflow": ".github/workflows/reconcile-live-status.yml",
    "rule": "automatic promotion is limited to orchestrator-owned branches; Product Reality PASS requires concrete evidence; status reconciliation opens a PR rather than pushing directly to main"
  },
  "growth_engine": {
    "schema_version": 1,
    "executable": "engineering/growth_engine.py",
    "workflow": ".github/workflows/growth-control-plane.yml",
    "learning_memory": "engineering/learning-memory.json",
    "capabilities": [
      "structured_engineering_learning",
      "evidence_ranked_next_slices",
      "conflict_aware_specialist_lane_planning",
      "product_reality_debt_visibility",
      "dependency_unlock_graph",
      "production_readiness_sentinel"
    ],
    "ranking_rule": "recommend highest-value reversible work from live evidence; P0/P1/existing ownership gates remain authoritative and recommendations never bypass preflight, CI, reviews, architecture, security, provenance, privacy, or Product Reality policy",
    "specialist_lane_rule": "parallel lanes may be proposed only when they do not overlap active PR ownership or each other; one scheduler retains merge authority",
    "learning_rule": "record verified failures, root causes, successful repairs, regression protection, and residual risk; never store secrets or private Product Reality payloads",
    "dependency_rule": "prefer slices that unblock more downstream work when priority and risk are otherwise comparable",
    "sentinel_rule": "surface architecture/security/governance/readiness drift only from observable evidence; do not fabricate percentages or acceptance"
  }
}
